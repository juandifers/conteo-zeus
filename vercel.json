{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/c/:token/events",
      "destination": "/api/c/:token?_op=events"
    },
    {
      "source": "/api/c/:token/resume",
      "destination": "/api/c/:token?_op=resume"
    },
    {
      "source": "/api/sessions/:id/sellar",
      "destination": "/api/sessions/:id/cierre?_op=sellar"
    },
    {
      "source": "/api/sessions/:id/exportar",
      "destination": "/api/sessions/:id/cierre?_op=exportar"
    },
    {
      "source": "/api/sessions/:id/bundle",
      "destination": "/api/sessions/:id/cierre?_op=bundle"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ]
}
